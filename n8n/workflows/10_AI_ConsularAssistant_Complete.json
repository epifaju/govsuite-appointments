        "jsCode": "let raw=$json.text??$json.output??$json.response??'';\nraw=String(raw).trim().replace(/^```json\\s*/i,'').replace(/^```\\s*/i,'').replace(/\\s*```$/i,'').trim();\nlet p={}; try{p=JSON.parse(raw)}catch(e){}\nconst allowed=['GET_SERVICES','GET_AVAILABILITY','CREATE_APPOINTMENT','GET_APPOINTMENT','CANCEL_APPOINTMENT','RESCHEDULE_APPOINTMENT','GENERAL'];\nconst t=$(\"Lorsqu'un message de chat est reçu\").item.json;\nreturn [{json:{intent:allowed.includes(p.intent)?p.intent:'GENERAL',confidence:Number(p.confidence??0),service:p.service??null,site:p.site??null,dateDebut:p.dateDebut??null,dateFin:p.dateFin??null,slotId:p.slotId??null,token:p.token??null,newSlotId:p.newSlotId??null,nom:p.nom??null,prenom:p.prenom??null,email:p.email??null,telephone:p.telephone??null,originalMessage:t.chatInput??'',sessionId:t.sessionId??null}}];"
      },
