    {
      "parameters": {
        "jsCode": "const token=String(($json.query||{}).token||'').trim(); if(!/^[0-9a-fA-F-]{36}$/.test(token)) throw new Error('token invalide'); return [{json:{token}}];"
      },
      "id": "1e0a14c4-b7be-4f93-8087-9b9b4d0e0743",
