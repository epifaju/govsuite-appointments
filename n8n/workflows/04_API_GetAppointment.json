        260,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT r.reference,r.nom,r.prenom,r.email,r.telephone,r.langue,r.statut,r.token_gestion,\n       c.debut,c.fin,s.code AS service,s.nom AS service_nom,si.code AS site,si.nom AS site_nom,si.adresse,si.ville,si.pays\nFROM rendez_vous r JOIN creneaux c ON c.id=r.creneau_id JOIN services s ON s.id=r.service_id JOIN sites si ON si.id=r.site_id\nWHERE r.token_gestion='{{$json.token}}'::uuid;",
        "options": {}
      },
      "id": "bbb56eea-226a-4ecc-95c4-4eb840e02eb0",
      "name": "Lire rendez-vous",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        520,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $input.all().length ? {success:true, appointment:$input.first().json} : {success:false,error:\"Rendez-vous introuvable\"} }}",
        "options": {
          "responseCode": 200
        }
      },
