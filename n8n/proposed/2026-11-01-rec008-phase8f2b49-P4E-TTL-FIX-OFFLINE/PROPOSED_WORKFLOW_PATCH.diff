## Politique d'expiration retenue (résumé)
# - Session active : charger + continuer collecte (priorité étape persistée).
# - Session expirée sans tentative ouverte : charger pour diagnostic, répondre
#   expiration, exiger reprise explicite (« reprendre ») ; ne pas prolonger TTL ;
#   ne pas effacer le brouillon.
# - Session expirée avec tentative ouverte : règles ai_appointment_attempt ;
#   jamais réactiver EXPIRED ; jamais POST depuis message libre ;
#   UNCERTAIN/SUBMITTING = RESUME replay only.
# TTL conversationnel (ai_conversation_state.expires_at, 2h) ≠ TTL tentative.

## Fix A — Charger état conversation
--- a/nodes/Charger_etat_conversation.sql
+++ b/nodes/Charger_etat_conversation.sql
@@
-SELECT *
-FROM ai_conversation_state
-WHERE session_id = $1
-  AND (
-      expires_at IS NULL
-      OR expires_at > NOW()
-  )
-LIMIT 1;
+SELECT
+    s.*,
+    TRUE AS session_found,
+    (s.expires_at IS NOT NULL AND s.expires_at <= NOW()) AS session_expired,
+    s.expires_at AS session_expires_at,
+    s.conversation_step AS "conversationStep",
+    s.pending_action AS "pendingAction"
+FROM ai_conversation_state AS s
+WHERE s.session_id = $1
+LIMIT 1;
 # (voir PROPOSED_FIX_A.sql pour la version colonnes explicites)

## Fix B — Parser intention (extrait à injecter après verrous ASK_TOKEN*)
--- a/nodes/Parser_intention.js
+++ b/nodes/Parser_intention.js
@@
+// --- P4E : drapeaux session (techniques, non publics) ---
+const sessionFound = previous.session_found === true || previous.sessionFound === true
+  || !!(previous.session_id || previous.pending_action || previous.conversation_step);
+const sessionExpired = previous.session_expired === true || previous.sessionExpired === true;
+const explicitResume = ['reprendre','reprendre ma demande','continuer','continuer ma demande']
+  .includes(decisionFolded);
+
+if (sessionFound && sessionExpired && !(openAttempt && ['UNCERTAIN','SUBMITTING','AWAITING_CONFIRMATION'].includes(openAttempt.status))) {
+  if (!(explicitResume && previousPendingAction === 'CREATE_APPOINTMENT')) {
+    intent = 'GENERAL';
+    // createDecision reste null → pas de CLAIM/POST
+  } else {
+    intent = 'CREATE_APPOINTMENT';
+  }
+} else if (
+  !sessionExpired &&
+  previousPendingAction === 'CREATE_APPOINTMENT' &&
+  ['ASK_NOM','ASK_PRENOM','ASK_EMAIL','ASK_TELEPHONE','ASK_CREATE_SLOT'].includes(previousConversationStep)
+) {
+  const explicitOverride =
+    affirmativeDecisions.has(decisionText) ||
+    affirmativeDecisions.has(decisionFolded) ||
+    negativeDecisions.has(decisionText) ||
+    negativeDecisions.has(decisionFolded) ||
+    !!modifyFieldOf(decisionFolded) ||
+    (/\b(prendre|reserver|creer)\b/.test(decisionFolded) && /\b(rendez-vous|rdv)\b/.test(decisionFolded));
+  if (!explicitOverride) {
+    intent = 'CREATE_APPOINTMENT';
+  }
+}

