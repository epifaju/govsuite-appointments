    {
      "parameters": {
        "jsCode": "const q = $json.query || {};\nconst token = String(q.token || '').trim();\n\nif (!/^[0-9a-fA-F-]{36}$/.test(token)) {\n  throw new Error('Token de gestion invalide');\n}\n\nreturn [{\n  json: {\n    token\n  }\n}];"
      },
      "id": "db8098c9-3fba-467f-ab68-0f8f383e1b4e",
      "name": "Valider token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        -128
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    rv.id,\n    rv.reference,\n    rv.statut,\n    rv.nom,\n    rv.prenom,\n    rv.email,\n    rv.telephone,\n    rv.token_gestion,\n    rv.created_at,\n    s.code AS service,\n    s.nom AS service_nom,\n    si.code AS site,\n    si.nom AS site_nom,\n    c.debut,\n    c.fin\nFROM rendez_vous rv\nJOIN creneaux c ON c.id = rv.creneau_id\nJOIN services s ON s.id = c.service_id\nJOIN sites si ON si.id = c.site_id\nWHERE rv.token_gestion = $1\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ [$json.token] }}"
        }
      },
      "id": "e44a7f9e-3738-463f-ba82-1943cd143fc4",
      "name": "Lire rendez-vous",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        192,
        -128
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "LlHYqyFvq4IkYbhP",
          "name": "credentials PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "2c83e68a-008e-43cf-b767-fb22a09f1e2b",
      "name": "Répondre",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        656,
        -128
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $json || {};\n\nif (!item.reference) {\n  return [{\n    json: {\n      success: false,\n      found: false,\n      message: 'Rendez-vous introuvable'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    success: true,\n    found: true,\n    appointment: item\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
