      "parameters": {
        "jsCode": "const b = $json.body || {};\nconst headers = $json.headers || {};\nconst clean = (v) => String(v ?? '').trim().normalize('NFC');\nconst missing = (v) => v === undefined || v === null || String(v).trim() === '';\nconst fail = (message) => [{ json: { ok: false, error: { code: 'VALIDATION_ERROR', message } } }];\nif (missing(b.slotId)) return fail('Le champ slotId est obligatoire.');\nif (missing(b.nom)) return fail('Le champ nom est obligatoire.');\nif (missing(b.prenom)) return fail('Le champ prénom est obligatoire.');\nconst slotId = String(b.slotId).trim();\nif (!/^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/.test(slotId)) return fail('Le champ slotId est invalide.');\nconst fromBody = b.cleIdempotence === undefined || b.cleIdempotence === null ? '' : String(b.cleIdempotence).trim();\nconst rawHeader = headers['idempotency-key'] ?? headers['Idempotency-Key'];\nconst fromHeader = rawHeader === undefined || rawHeader === null ? '' : String(rawHeader).trim();\nif (fromBody && fromHeader && fromBody !== fromHeader) return fail('Les alias de la clé d\\'idempotence ne correspondent pas.');\nconst cleIdempotence = fromBody || fromHeader || null;\nif (cleIdempotence && !/^[A-Za-z0-9._~-]{16,128}$/.test(cleIdempotence)) return fail('Le champ cleIdempotence est invalide.');\nreturn [{\n  json: {\n    ok: true,\n    slotId,\n    nom: clean(b.nom),\n    prenom: clean(b.prenom),\n    email: clean(b.email),\n    telephone: clean(b.telephone),\n    numeroDocument: clean(b.numeroDocument),\n    langue: clean(b.langue || 'fr'),\n    cleIdempotence\n  }\n}];"
      },
