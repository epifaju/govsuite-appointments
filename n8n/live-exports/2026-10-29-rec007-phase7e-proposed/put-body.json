        "query": "SELECT issue, id, reference, token_gestion, statut, email, telephone, debut, fin, service, site\nFROM public.creer_rendez_vous_idempotent(\n  $1::uuid,\n  $2,\n  $3,\n  NULLIF($4, ''),\n  NULLIF($5, ''),\n  NULLIF($6, ''),\n  NULLIF($7, ''),\n  NULLIF($8, '')\n);",
        "options": {
          "queryReplacement": "={{ [$json.slotId, $json.nom, $json.prenom, $json.email, $json.telephone, $json.numeroDocument, $json.langue, $json.cleIdempotence] }}"
        }
