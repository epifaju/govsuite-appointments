  "patterns": [
    {
      "id": "HYG-E01",
      "class": "email_cleartext",
      "regex": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b",
      "onMatch": "FAIL",
      "stopCode": "pii-cleartext-email",
      "mapsTo": ["R04-P01", "SEC-C07", "pii-in-report"],
      "allowedReplacements": ["emailPresent", "emailLen", "emailIsNull", "emailHash"]
    },
    {
      "id": "HYG-T01",
      "class": "phone_cleartext_e164_fr",
      "regex": "\\+33\\s?[1-9](?:[\\s.-]?\\d{2}){4}",
      "onMatch": "FAIL",
      "stopCode": "pii-cleartext-phone",
      "mapsTo": ["R05-P01", "SEC-C07", "pii-in-report"],
      "allowedReplacements": ["telephonePresent", "telephoneLen", "telephoneIsNull", "telephoneHash"]
    },
    {
      "id": "HYG-T02",
      "class": "phone_cleartext_national_fr",
      "regex": "\\b0[1-9](?:[\\s.-]?\\d{2}){4}\\b",
      "onMatch": "FAIL",
      "stopCode": "pii-cleartext-phone",
      "mapsTo": ["R05-P01", "SEC-C07", "pii-in-report"],
      "allowedReplacements": ["telephonePresent", "telephoneLen", "telephoneIsNull", "telephoneHash"]
    },
    {
      "id": "HYG-S01",
      "class": "bearer_token",
      "regex": "(?i)\\bBearer\\s+[A-Za-z0-9\\-._~+/]+=*",
      "onMatch": "FAIL",
      "stopCode": "secret-or-token-cleartext",
      "mapsTo": ["SEC-C07"]
    },
    {
      "id": "HYG-S02",
      "class": "jwt",
      "regex": "\\beyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\b",
      "onMatch": "FAIL",
      "stopCode": "secret-or-token-cleartext",
      "mapsTo": ["SEC-C07"]
    },
    {
      "id": "HYG-S03",
      "class": "named_api_secret",
      "regex": "(?i)(api[_-]?key|access[_-]?token|refresh[_-]?token|client[_-]?secret)\\s*[:=]\\s*\\S+",
      "onMatch": "FAIL",
      "stopCode": "secret-or-token-cleartext",
      "mapsTo": ["SEC-C07"]
    },
    {
      "id": "HYG-S04",
      "class": "password_assignment",
      "regex": "(?i)(password|passwd|pwd)\\s*[:=]\\s*\\S+",
      "onMatch": "FAIL",
      "stopCode": "secret-or-token-cleartext",
      "mapsTo": ["SEC-C07"]
    },
    {
      "id": "HYG-S05",
      "class": "n8n_cookie_or_api",
      "regex": "(?i)(n8n[_-]?api[_-]?key|cookie)\\s*[:=]\\s*\\S+",
      "onMatch": "FAIL",
      "stopCode": "secret-or-token-cleartext",
      "mapsTo": ["SEC-C07"]
    },
    {
      "id": "HYG-S06",
      "class": "reservation_token_uuid_json",
      "regex": "(?i)\"(?:token|reservation[_-]?token|manage[_-]?token)\"\\s*:\\s*\"[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\"",
      "onMatch": "FAIL",
      "stopCode": "secret-or-token-cleartext",
      "mapsTo": ["SEC-C07"],
      "addedIn": "032"
    },
    {
      "id": "HYG-S07",
      "class": "n8n_encryption_key",
      "regex": "(?i)N8N_ENCRYPTION_KEY\\s*[:=]\\s*\\S+",
      "onMatch": "FAIL",
      "stopCode": "secret-or-token-cleartext",
      "mapsTo": ["SEC-C07"],
      "addedIn": "032"
    },
    {
      "id": "HYG-S08",
      "class": "json_secret_fields",
      "regex": "(?i)\"(?:password|secret|private[_-]?key|encryption[_-]?key)\"\\s*:\\s*\"[^\"]+\"",
      "onMatch": "FAIL",
      "stopCode": "secret-or-token-cleartext",
      "mapsTo": ["SEC-C07"],
      "addedIn": "032"
    },
    {
      "id": "HYG-T03",
      "class": "phone_cleartext_e164_intl",
      "regex": "\\+[1-9]\\d{6,14}\\b",
      "onMatch": "FAIL",
      "stopCode": "pii-cleartext-phone",
      "mapsTo": ["R05-P01", "SEC-C07"],
      "allowedReplacements": ["telephonePresent", "telephoneLen", "telephoneHash"],
      "addedIn": "032",
      "note": "E.164 generic; may overlap FR +33 — still FAIL cleartext"
    }
  ],
