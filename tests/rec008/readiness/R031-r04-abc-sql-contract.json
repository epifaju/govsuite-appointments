    "sharedTemplate": "SELECT conversation_step, (nom IS NOT NULL AND btrim(nom) <> '') AS \"nomPresent\", COALESCE(length(nom), 0) AS \"nomLen\", (prenom IS NOT NULL AND btrim(prenom) <> '') AS \"prenomPresent\", COALESCE(length(prenom), 0) AS \"prenomLen\", (email IS NOT NULL AND btrim(email) <> '') AS \"emailPresent\", COALESCE(length(email), 0) AS \"emailLen\", (telephone IS NOT NULL AND btrim(telephone) <> '') AS \"telephonePresent\", COALESCE(length(telephone), 0) AS \"telephoneLen\", (slot_id IS NOT NULL) AS \"slotIdPresent\", (expires_at IS NOT NULL AND expires_at > NOW()) AS \"ttlActive\", (expires_at IS NOT NULL AND expires_at <= NOW()) AS \"sessionExpired\", expires_at, updated_at FROM ai_conversation_state WHERE session_id = $1 LIMIT 1;",
    "attemptsSideCheck": "SELECT COUNT(*)::int AS \"openAttempts\" FROM ai_appointment_attempt WHERE session_id = $1 AND status IN ('AWAITING_CONFIRMATION','SUBMITTING','UNCERTAIN','CONFIRMED');",
    "deltaSideCheck": "mockClaimsDelta=0 ; mockPostsDelta=0 (empreinte mock / compteurs runner — hors SELECT métier)",
    "note": "Ne jamais SELECT nom/prenom/email/telephone en clair dans les preuves ; Present/Len uniquement."
