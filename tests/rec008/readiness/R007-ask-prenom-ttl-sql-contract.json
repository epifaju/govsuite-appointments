        "S01_S02_S03": "aucune _authorizedNulls attendue (pas d'abandon NEGATIVE)"
      },
      "lock": "existing CTE FOR UPDATE on session_id",
      "upsert": "ON CONFLICT (session_id) DO UPDATE"
    },
