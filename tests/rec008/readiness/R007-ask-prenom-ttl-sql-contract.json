        "sql": "COALESCE((data->>'refreshSessionTtl')::boolean, true)",
        "whenTrue": "expires_at = NOW() + INTERVAL '2 hours'",
        "whenFalse": "expires_at = COALESCE(previous_expires_at, NOW())",
        "updated_at": "toujours NOW() même si TTL non rafraîchi"
      },
      "authorizedNulls": {
        "sql": "ARRAY from data->_authorizedNulls ; clear only if key present AND value null AND key = ANY(authorized_nulls)",
